<Window
    x:Class="OpenAITunnelManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenAI MCP Tunnel Manager">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="22" Height="22" />
                <TextBlock Text="OpenAI MCP Tunnel Manager" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="连接" Tag="connections" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Padding="24,20,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DashboardPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="当前 tunnel-client 与连接运行情况" Opacity="0.7" />
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="8"><TextBlock Text="活跃连接" Opacity="0.65" /><TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="正在运行" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="8"><TextBlock Text="Health" Opacity="0.65" /><TextBlock Text="{Binding HealthyCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="健康且 Ready" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="8"><TextBlock Text="tunnel-client" Opacity="0.65" /><TextBlock Text="{Binding ClientVersion}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="版本 / 可用状态" /></StackPanel>
                                    </Border>
                                </Grid>
                                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="12">
                                        <Grid><TextBlock Text="当前连接" FontSize="18" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" Text="{Binding TotalCount}" Opacity="0.65" /></Grid>
                                        <ItemsControl ItemsSource="{Binding Connections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="4,8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" Opacity="0.65" />
                                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ConnectionsPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="连接" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="直接读取和管理 tunnel-client Profile / Runtime" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                                <Button Click="AddProfile_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="新建 Profile" /></StackPanel></Button>
                                <Button Command="{Binding RefreshCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="刷新" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="配置列表" FontSize="16" FontWeight="SemiBold" />
                                    <ListView x:Name="ConnectionsList" Grid.Row="2" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" SelectionMode="Single" SelectionChanged="ConnectionsList_SelectionChanged">
                                        <ListView.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="编辑" Click="EditProfile_Click" />
                                                <MenuFlyoutItem Text="删除" Click="DeleteSelected_Click" />
                                            </MenuFlyout>
                                        </ListView.ContextFlyout>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="8,3" CornerRadius="8" VerticalAlignment="Center" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="{Binding StatusLabel}" FontSize="12" /></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4"><TextBlock Text="{Binding SelectedConnection.Name, FallbackValue=请选择配置}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedConnection.TunnelId}" Opacity="0.65" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <Border Grid.Column="1" Padding="10,5" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding SelectedConnection.StateText}" /></Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="启动" Command="{Binding StartSelectedCommand}" IsEnabled="{Binding CanStartSelected}" Click="StartSelected_Click" />
                                            <Button Content="停止" Command="{Binding StopSelectedCommand}" IsEnabled="{Binding CanStopSelected}" />
                                            <Button Content="重启" Command="{Binding RestartSelectedCommand}" IsEnabled="{Binding CanRestartSelected}" />
                                            <Button Content="编辑 Profile" IsEnabled="{Binding CanEditSelected}" Click="EditProfile_Click" />
                                            <Button Content="本机偏好 / 密钥" IsEnabled="{Binding CanDeleteSelected}" Click="EditPreference_Click" />
                                            <Button Content="删除" IsEnabled="{Binding CanDeleteSelected}" Click="DeleteSelected_Click" />
                                        </StackPanel>
                                        <Separator />
                                        <TextBlock Text="基本信息" FontSize="16" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="20" RowSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="来源" Opacity="0.65" /><TextBlock Grid.Column="1" Text="{Binding SelectedConnection.SourceText}" />
                                            <TextBlock Grid.Row="1" Text="Profile" Opacity="0.65" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConnection.ProfileName}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Text="Profile 路径" Opacity="0.65" /><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding SelectedConnection.ProfilePath}" TextWrapping="Wrap" /><Button Content="打开位置" IsEnabled="{Binding CanOpenConfigSelected}" Click="OpenConfigLocation_Click" /></StackPanel>
                                            <TextBlock Grid.Row="3" Text="Runtime Alias" Opacity="0.65" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnection.RuntimeAlias}" />
                                            <TextBlock Grid.Row="4" Text="MCP Target" Opacity="0.65" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedConnection.TargetValue}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="5" Text="PID" Opacity="0.65" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedConnection.ProcessId}" />
                                            <TextBlock Grid.Row="6" Text="日志文件" Opacity="0.65" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentLogPath}" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="健康状态" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <Grid ColumnSpacing="20" RowSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="状态" Opacity="0.65" /><TextBlock Grid.Column="1" Text="{Binding SelectedConnection.StateText}" />
                                            <TextBlock Grid.Row="1" Text="Health" Opacity="0.65" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConnection.HealthText}" />
                                            <TextBlock Grid.Row="2" Text="Ready" Opacity="0.65" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedConnection.ReadyText}" />
                                            <TextBlock Grid.Row="3" Text="Health URL" Opacity="0.65" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnection.HealthUrl}" TextWrapping="Wrap" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="查看日志" Click="ShowLogs_Click" /><Button Content="诊断" Command="{Binding DiagnoseSelectedCommand}" IsEnabled="{Binding CanDiagnoseSelected}" Click="ShowDiagnostics_Click" /></StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="4"><TextBlock Text="日志" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="读取 tunnel-client Runtime 或 GUI 前台 Profile 日志" Opacity="0.7" /></StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Content="立即刷新" Command="{Binding RefreshLogCommand}" /><Button Content="复制可见日志" Click="CopyLog_Click" /><Button Content="打开文件位置" IsEnabled="{Binding CanOpenLogSelected}" Click="OpenLogLocation_Click" /></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="ConnectionsList_SelectionChanged" />
                            <TextBox Grid.Column="1" PlaceholderText="搜索日志" Text="{Binding LogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2" x:Name="LogLevelCombo" SelectedValue="{Binding LogLevel, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="全部" IsSelected="True" /><ComboBoxItem Content="DEBUG" /><ComboBoxItem Content="INFO" /><ComboBoxItem Content="WARN" /><ComboBoxItem Content="ERROR" /></ComboBox>
                            <CheckBox Grid.Column="3" Content="自动刷新" IsChecked="{Binding LogAutoRefresh, Mode=TwoWay}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="4" x:Name="LogWrapCheckBox" Content="自动换行" IsChecked="{Binding LogWrap, Mode=TwoWay}" VerticalAlignment="Center" Checked="LogWrap_Changed" Unchecked="LogWrap_Changed" />
                        </Grid>
                        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBox x:Name="LogTextBox" Text="{Binding VisibleLog}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" />
                        </Border>
                        <TextBlock Grid.Row="6" Text="{Binding CurrentLogPath}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="4"><TextBlock Text="诊断" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="运行 doctor --explain 并检查详细 Health" Opacity="0.7" /></StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Content="详细 Health" Command="{Binding RefreshHealthCommand}" /><Button Content="开始诊断" Command="{Binding DiagnoseSelectedCommand}" IsEnabled="{Binding CanDiagnoseSelected}" /></StackPanel>
                        </Grid>
                        <ComboBox Grid.Row="2" Width="320" HorizontalAlignment="Left" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="ConnectionsList_SelectionChanged" />
                        <Grid Grid.Row="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Doctor 输出" FontSize="16" FontWeight="SemiBold" /><TextBox Grid.Row="2" Text="{Binding DiagnosticText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" BorderThickness="0" Background="Transparent" /></Grid>
                            </Border>
                            <Border Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Health 详情" FontSize="16" FontWeight="SemiBold" /><TextBox Grid.Row="2" Text="{Binding HealthText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" BorderThickness="0" Background="Transparent" /></Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="20" MaxWidth="1050" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4"><TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Manager 本机设置；不会复制 tunnel-client 的 Tunnel 配置" Opacity="0.7" /></StackPanel>
                                <InfoBar x:Name="MissingClientInfo" IsOpen="True" IsClosable="False" Severity="Warning" Title="tunnel-client" Message="如果未检测到 tunnel-client，请选择 tunnel-client.exe 后保存。" />
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <Grid Padding="18" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="tunnel-client" FontWeight="SemiBold" /><TextBlock Text="选择要管理的 tunnel-client.exe" Opacity="0.65" FontSize="12" /></StackPanel><TextBox Grid.Column="1" Text="{Binding TunnelClientPath, Mode=TwoWay}" PlaceholderText="tunnel-client.exe 完整路径" /><Button Grid.Column="2" Content="浏览" Click="BrowseTunnelClient_Click" /></Grid>
                                        <Separator />
                                        <Grid Padding="18" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="自动刷新" FontWeight="SemiBold" /><TextBlock Text="Profile / Runtime 状态刷新间隔" Opacity="0.65" FontSize="12" /></StackPanel><NumberBox Grid.Column="1" Width="160" HorizontalAlignment="Left" Minimum="2" Maximum="300" SpinButtonPlacementMode="Compact" Value="{Binding RefreshIntervalSeconds, Mode=TwoWay}" Header="秒" /></Grid>
                                        <Separator />
                                        <Grid Padding="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关闭到系统托盘" FontWeight="SemiBold" /><TextBlock Text="点击关闭按钮时隐藏窗口，Runtime 与自动重连继续工作" Opacity="0.65" FontSize="12" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{Binding CloseToTray, Mode=TwoWay}" /></Grid>
                                        <Separator />
                                        <Grid Padding="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Windows 登录时启动" FontWeight="SemiBold" /><TextBlock Text="使用当前用户 HKCU Run 注册表项" Opacity="0.65" FontSize="12" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{Binding StartWithWindows, Mode=TwoWay}" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Expander Header="高级：tunnel-client 环境目录覆盖" IsExpanded="False">
                                    <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="默认留空：继承当前 Windows 环境和 tunnel-client 默认目录。只有确实需要隔离环境时才填写。" TextWrapping="Wrap" Opacity="0.7" />
                                            <TextBox Header="TUNNEL_CLIENT_PROFILE_DIR" Text="{Binding ProfileDirectoryOverride, Mode=TwoWay}" />
                                            <TextBox Header="TUNNEL_CLIENT_STATE_DIR" Text="{Binding StateDirectoryOverride, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                                <Grid><TextBlock Text="{Binding SettingsPath}" Opacity="0.65" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Content="保存设置" Click="SaveSettings_Click" /></Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Title="状态" Message="{Binding StatusMessage}" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
