<Window
    x:Class="OpenAITunnelManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenAI MCP Tunnel Manager">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE774;" FontSize="16" />
                <TextBlock Text="OpenAI MCP Tunnel Manager" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="连接" Tag="connections" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Padding="24,20,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="连接" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="管理 tunnel-client Profile、Runtime 与运行状态" Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                            <Button Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <AutoSuggestBox PlaceholderText="搜索连接（后续支持）" IsEnabled="False" />
                                <ListView
                                    x:Name="ConnectionsList"
                                    Grid.Row="2"
                                    ItemsSource="{Binding Connections}"
                                    SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="999" VerticalAlignment="Center"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding SelectedConnection.Name, FallbackValue=选择一个连接}" FontSize="24" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedConnection.TunnelId}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="10,5" CornerRadius="999" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SelectedConnection.StatusLabel}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="启动" IsEnabled="False" />
                                        <Button Content="停止" Command="{Binding StopSelectedCommand}" />
                                        <Button Content="重启" IsEnabled="False" />
                                    </StackPanel>

                                    <NavigationViewItemSeparator />

                                    <TextBlock Text="基本信息" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="20" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Profile" Opacity="0.65" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedConnection.ProfileName}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="Runtime Alias" Opacity="0.65" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConnection.RuntimeAlias}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="MCP Target" Opacity="0.65" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedConnection.TargetValue}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Text="Profile 文件" Opacity="0.65" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnection.ProfilePath}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Text="日志文件" Opacity="0.65" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedConnection.LogPath}" TextWrapping="Wrap" />
                                    </Grid>

                                    <TextBlock Text="健康状态" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <Grid ColumnSpacing="20" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Process" Opacity="0.65" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedConnection.ProcessRunning}" />
                                        <TextBlock Grid.Row="1" Text="Health" Opacity="0.65" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConnection.Healthy}" />
                                        <TextBlock Grid.Row="2" Text="Ready" Opacity="0.65" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedConnection.Ready}" />
                                        <TextBlock Grid.Row="3" Text="Health URL" Opacity="0.65" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnection.HealthUrl}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <InfoBar
                        Grid.Row="4"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="tunnel-client"
                        Message="{Binding StatusMessage}" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
