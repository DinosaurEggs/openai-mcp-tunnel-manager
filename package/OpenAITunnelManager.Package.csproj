<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>OpenAITunnelManager.Windows</PackageId>
    <Version>1.0.0</Version>
    <Authors>DinosaurEggs</Authors>
    <Description>Windows single-file executable for OpenAI MCP Tunnel Manager.</Description>
    <RepositoryUrl>https://github.com/DinosaurEggs/openai-mcp-tunnel-manager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../dist/OpenAITunnelManager.exe" Pack="true" PackagePath="tools/" />
    <None Include="../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
